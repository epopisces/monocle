# Monocle — Example Secret Variables
#
# Copy this file to .env and fill in your values.
# Environment variables always take precedence over values in this file.

# MCP server access key (used in x-monocle-key header)
MCP_ACCESS_KEY=change-me-before-use

# Azure OpenAI (required only when ai.provider = azure)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# OpenAI (required only when any ai.models entry uses provider=openai)
# OPENAI_API_KEY=

# Foundry Local (optional — overrides config.yaml foundry_local_base_url)
# FOUNDRY_LOCAL_BASE_URL=http://localhost:5272
# FOUNDRY_LOCAL_API_KEY=
